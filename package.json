{
  "name": "gh-labeler",
  "version": "0.1.8",
  "description": "Declarative GitHub label management for humans and AI agents",
  "keywords": [
    "ai-agents",
    "automation",
    "cli",
    "github",
    "labels",
    "sync"
  ],
  "homepage": "https://github.com/kkhys/gh-labeler#readme",
  "bugs": {
    "url": "https://github.com/kkhys/gh-labeler/issues"
  },
  "license": "MIT",
  "author": "Keisuke Hayashi <hi@kkhys.me>",
  "repository": {
    "type": "git",
    "url": "https://github.com/kkhys/gh-labeler.git"
  },
  "bin": {
    "gh-labeler": "./dist/cli/index.js",
    "ghl": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "schema",
    "AGENTS.md",
    "README.md",
    "LICENSE.md"
  ],
  "type": "module",
  "imports": {
    "#*": {
      "development": "./src/*",
      "default": "./dist/*"
    }
  },
  "exports": {},
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "lefthook install",
    "prepublishOnly": "pnpm run build",
    "version": "changeset version",
    "release": "pnpm run build && changeset publish",
    "release:dry-run": "pnpm run build && pnpm publish --dry-run"
  },
  "dependencies": {
    "@octokit/plugin-retry": "8.1.1",
    "@octokit/plugin-throttling": "11.0.5",
    "@octokit/rest": "22.0.1",
    "commander": "14.0.3",
    "picocolors": "1.1.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@changesets/get-github-info": "0.8.0",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "lefthook": "2.1.10",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.20.0"
}
